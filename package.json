{
	"name": "arbitrage-volley",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"test": "vitest run --project unit",
		"test:integration": "vitest run --project integration",
		"db:dev": "tsx scripts/db/appliquer.ts --cible dev",
		"charger:dev": "tsx scripts/import/charger.ts --cible dev",
		"charger:prod": "tsx scripts/import/charger.ts --cible prod",
		"fonctions:dev": "tsx scripts/db/deployer-fonctions.ts --cible dev",
		"fonctions:prod": "tsx scripts/db/deployer-fonctions.ts --cible prod"
	},
	"devDependencies": {
		"@sveltejs/adapter-static": "^4.0.0",
		"@sveltejs/kit": "^3.0.0",
		"@sveltejs/vite-plugin-svelte": "^7.2.0",
		"@testing-library/jest-dom": "^7.0.1",
		"@testing-library/svelte": "^5.4.2",
		"@types/node": "^26.6.5",
		"@types/pg": "^8.23.1",
		"dotenv": "^18.0.8",
		"jsdom": "^30.1.3",
		"pg": "^8.23.1",
		"svelte": "^5.57.1",
		"svelte-check": "^4.6.0",
		"tsx": "^4.23.15",
		"typescript": "^6.0.3",
		"vite": "^8.3.0",
		"vitest": "^5.0.5"
	},
	"imports": {
		"#lib": "./src/lib/index.js",
		"#lib/*": "./src/lib/*"
	},
	"dependencies": {
		"@fontsource/sofia-sans": "^5.3.0",
		"@fontsource/sofia-sans-condensed": "^5.3.0",
		"@supabase/supabase-js": "^2.118.0"
	}
}
