# Copier en .env.local (ignoré par Git) et remplir.
# Front (clés publiques, embarquées dans le site)
PUBLIC_SUPABASE_URL=
PUBLIC_SUPABASE_ANON_KEY=
# Tests d'intégration : projet Supabase de DÉVELOPPEMENT uniquement
SUPABASE_TEST_URL=
SUPABASE_TEST_ANON_KEY=
SUPABASE_TEST_SERVICE_KEY=
# Chargeur de contenu en production (scripts locaux uniquement, jamais dans le front)
SUPABASE_PROD_URL=
SUPABASE_PROD_SERVICE_KEY=
